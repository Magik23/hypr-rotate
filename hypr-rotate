#!/usr/bin/env bash
set -euo pipefail

# Rotate only the focused monitor at runtime. Hyprland's saved configuration
# and the user's keyboard bindings are deliberately left untouched.
for dependency in hyprctl jq; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        printf 'hypr-rotate: required command not found: %s\n' "$dependency" >&2
        exit 1
    fi
done

# Require exactly one focused monitor. Reject missing or malformed monitor
# data instead of silently choosing an arbitrary output.
focused="$(
    hyprctl monitors -j |
        jq -er '
            if type != "array" then empty
            else
                [.[] | select(.focused == true)] |
                if length != 1 then empty
                else
                    .[0] |
                    if (.name | type) == "string" and (.transform | type) == "number"
                    then [.name, .transform] | @tsv
                    else empty
                    end
                end
            end
        '
)" || {
    echo 'hypr-rotate: unable to read exactly one valid focused monitor.' >&2
    exit 1
}

IFS=$'\t' read -r monitor current <<< "$focused"

# Connector names are normally eDP-1, DP-1, HDMI-A-2, etc. Validate before
# embedding the name in a Lua string passed to hyprctl eval.
if [[ ! "$monitor" =~ ^[a-zA-Z0-9_.:-]+$ ]]; then
    echo 'hypr-rotate: invalid monitor name returned by Hyprland.' >&2
    exit 1
fi

# Only cycle through the four non-mirrored orientations.
case "$current" in
    0|1|2|3) ;;
    4|5|6|7)
        printf 'hypr-rotate: mirrored transform %s is not supported.\n' "$current" >&2
        exit 1
        ;;
    *)
        printf 'hypr-rotate: invalid monitor transform: %s\n' "$current" >&2
        exit 1
        ;;
esac

next=$(( (current + 1) % 4 ))

if ! hyprctl eval "hl.monitor({ output = \"$monitor\", transform = $next })" >/dev/null; then
    printf 'hypr-rotate: failed to rotate monitor %s.\n' "$monitor" >&2
    exit 1
fi

# Successful rotation is intentionally silent. The monitor itself is feedback.
